<Window x:Class="SnakeGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rắn săn mồi"
        Width="670"
        Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#20252B">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="RẮN SĂN MỒI"
                   Foreground="#71D368"
                   FontSize="34"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Background="#2D343C"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,12">
            <TextBlock x:Name="ScoreText"
                       Text="Điểm: 0"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="2"
                Width="600"
                Height="500"
                BorderBrush="#65717E"
                BorderThickness="2"
                Background="#111417"
                HorizontalAlignment="Center">
            <Canvas x:Name="GameCanvas"
                    Width="600"
                    Height="500"
                    ClipToBounds="True" />
        </Border>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0">
            <TextBlock Text="Khung giao diện ban đầu"
                       Foreground="White"
                       FontSize="17"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10" />

            <Button Content="Bắt đầu"
                    Width="150"
                    Height="42"
                    FontSize="17"
                    FontWeight="SemiBold"
                    IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
